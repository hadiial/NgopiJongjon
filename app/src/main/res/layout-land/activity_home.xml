<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_auth"
    tools:context=".HomeActivity">

    <!-- Place the vertical guideline along the curve at 38% of the screen width -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.38" />

    <!-- Display the logo on the left espresso section -->
    <ImageView
        android:id="@+id/ivHeaderLogo"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:contentDescription="@string/placeholder_logo"
        android:scaleType="fitCenter"
        android:src="@drawable/icon"
        app:layout_constraintBottom_toTopOf="@+id/tvGreeting"
        app:layout_constraintEnd_toStartOf="@+id/guidelineHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <!-- Personalized greeting header below the logo -->
    <TextView
        android:id="@+id/tvGreeting"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="#E8CFAF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/tvSubGreeting"
        app:layout_constraintEnd_toStartOf="@+id/guidelineHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivHeaderLogo"
        tools:text="@string/greeting_format" />

    <!-- Sub-greeting below the main greeting -->
    <TextView
        android:id="@+id/tvSubGreeting"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text="@string/home_sub_greeting"
        android:textColor="#CCFFFFFF"
        android:textSize="12sp"
        app:layout_constraintBottom_toTopOf="@+id/cvBottomNav"
        app:layout_constraintEnd_toStartOf="@+id/guidelineHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvGreeting" />

    <!-- Side Navigation (Drawer style) on the left espresso section -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvBottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guidelineHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvSubGreeting">

        <LinearLayout
            android:id="@+id/llBottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Home Tab (Active reverse color) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavHome"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginBottom="8dp"
                android:backgroundTint="#E8CFAF"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/nav_home"
                android:textAllCaps="false"
                android:textColor="#1C0B03"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />

            <!-- Order Tab (Inactive on espresso background with outline) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavOrder"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginBottom="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/nav_order"
                android:textAllCaps="false"
                android:textColor="#E8CFAF"
                android:textSize="14sp"
                app:backgroundTint="@android:color/transparent"
                app:cornerRadius="12dp"
                app:strokeColor="#E8CFAF"
                app:strokeWidth="1dp" />

            <!-- Profile Tab (Inactive on espresso background with outline) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavProfile"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/nav_profile"
                android:textAllCaps="false"
                android:textColor="#E8CFAF"
                android:textSize="14sp"
                app:backgroundTint="@android:color/transparent"
                app:cornerRadius="12dp"
                app:strokeColor="#E8CFAF"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Menu category filter tabs on the right white section -->
    <LinearLayout
        android:id="@+id/llFilterTabs"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/guidelineHeader"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTabAll"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/btn_dark"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/tab_semua"
            android:textAllCaps="false"
            android:textColor="@color/bg_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="20dp"
            app:strokeWidth="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTabDrinks"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/surface_card"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/tab_minuman"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="20dp"
            app:strokeColor="@color/border_light"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTabFood"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/surface_card"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/tab_makanan"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="20dp"
            app:strokeColor="@color/border_light"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <!-- Displayed menu items list filling the rest of the right section -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMenu"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="12dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/guidelineHeader"
        app:layout_constraintTop_toBottomOf="@+id/llFilterTabs"
        tools:listitem="@layout/item_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>