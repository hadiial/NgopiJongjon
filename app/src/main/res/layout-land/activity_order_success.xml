<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_auth"
    tools:context=".OrderSuccessActivity">

    <!-- Place the vertical guideline along the curve at 38% of the screen width -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.38" />

    <!-- Place the logo on the left espresso section -->
    <ImageView
        android:id="@+id/ivHeaderLogo"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:contentDescription="@string/placeholder_logo"
        android:scaleType="fitCenter"
        android:src="@drawable/icon"
        app:layout_constraintBottom_toTopOf="@+id/tvSuccessGreeting"
        app:layout_constraintEnd_toStartOf="@+id/guidelineHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <!-- Personalized greeting header below the logo on the left section -->
    <TextView
        android:id="@+id/tvSuccessGreeting"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textColor="#E8CFAF"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guidelineHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivHeaderLogo"
        tools:text="@string/greeting_format" />

    <!-- Green pill status badge on the right white section -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvStatusOk"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/status_success_bg"
        app:cardCornerRadius="36dp"
        app:cardElevation="0dp"
        app:strokeColor="#332E7D32"
        app:strokeWidth="2dp"
        app:layout_constraintBottom_toTopOf="@+id/tvOrderMessage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/guidelineHeader"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingHorizontal="32dp"
            android:paddingVertical="12dp"
            android:text="@string/status_ok"
            android:textColor="@color/status_success_text"
            android:textSize="20sp"
            android:textStyle="bold" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Order confirmation thank you message -->
    <TextView
        android:id="@+id/tvOrderMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="36dp"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:lineSpacingExtra="5dp"
        android:text="@string/order_success_msg"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        app:layout_constraintBottom_toTopOf="@+id/btnOke"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/guidelineHeader"
        app:layout_constraintTop_toBottomOf="@+id/cvStatusOk" />

    <!-- Confirmation button at the bottom right -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOke"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginHorizontal="40dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/btn_dark"
        android:text="@string/btn_oke"
        android:textAllCaps="false"
        android:textColor="@color/bg_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/guidelineHeader"
        app:layout_constraintTop_toBottomOf="@+id/tvOrderMessage" />

</androidx.constraintlayout.widget.ConstraintLayout>